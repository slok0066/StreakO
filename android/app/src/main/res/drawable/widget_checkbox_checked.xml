<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer solid circle -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#4A9E5C"/> <!-- Premium Success Green boundary -->
            <solid android:color="#4A9E5C"/>
            <size android:width="20dp" android:height="20dp"/>
        </shape>
    </item>
    <!-- Inner OLED-black dot -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="#0B0B0B"/> <!-- OLED Black center dot matching card background -->
        </shape>
    </item>
</layer-list>
