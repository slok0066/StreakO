<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAILY_CAPACITY"
        android:textColor="#66FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="%"
            android:textColor="#33FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <View android:id="@+id/seg_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" android:layout_marginEnd="1dp" />
        <View android:id="@+id/seg_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="AWAITING_SYNC"
        android:textColor="#4DFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
